# IDIA Server — Environment Configuration Template
#
# Copy this file to .env and fill in your values.
# NEVER commit .env — it contains secrets.
#
# Required variables:
#   HF_TOKEN, LITELLM_MASTER_KEY, MODEL_ID, MODEL_SOURCE
#
# Optional variables (with defaults):
#   MAX_MODEL_LEN = 8192, GPU_MEMORY_UTILIZATION = 0.9
#
# Multi-model mode: set MODELS_COUNT=N and MODEL_1_ID..MODEL_N_SOURCE
#   (omit MODEL_ID/MODEL_SOURCE when using multi-model mode)
#
# See docs/ARCHITECTURE.md §5.5 and AGENTS.md §Env Var Convention.

# HuggingFace token — required for downloading gated models
HF_TOKEN=hf_xxx

# LiteLLM master admin key — used to generate virtual keys
LITELLM_MASTER_KEY=sk-litellm-admin-change-me

# ── Banco do LiteLLM ──────────────────────────────────────────────────────
# Obrigatório. O LiteLLM v1.85.0 exige PostgreSQL para virtual keys, spend
# tracking e rate limiting — sem isto, nenhuma chave de usuário pode ser
# criada e só a master key funciona. Ver ADR-012.
# Gere com:  openssl rand -base64 24
POSTGRES_PASSWORD=

# Credenciais do painel admin do LiteLLM em http://<host>:4000/ui.
# Distintas da master key: esta é a credencial de API, aquela é de acesso
# à interface. UI_PASSWORD é obrigatória.
UI_USERNAME=admin
UI_PASSWORD=

# ── Model Configuration ───────────────────────────────────────────────────
# Single-model mode (backward compatible):
# Short alias for the model — clients use this in the `model` field
MODEL_ID=mistral-7b
# Full HuggingFace Hub identifier for the model (open model, no gating required)
MODEL_SOURCE=mistralai/Mistral-7B-Instruct-v0.3

# ── Opções de engine por modelo (opcionais) ───────────────────────────────
# Em single-model valem tanto MODEL_1_* quanto a forma sem número.
# Em multi-model, use MODEL_N_* para cada modelo.
#
#   *_DTYPE         float16 para AWQ/GPTQ, bfloat16 caso contrário
#                   (default: bfloat16)
#   *_QUANTIZATION  awq | gptq | fp8 | vazio para pesos FP16
#                   (default: vazio — sem linha de quantização)
#   *_MIN_REPLICAS  0 = scale-to-zero (libera a GPU quando ocioso)
#                   1 = sempre residente (sem cold start)
#                   (default: 0)
#
# Exemplo — um modelo AWQ sempre carregado:
# MODEL_1_QUANTIZATION=awq
# MODEL_1_DTYPE=float16
# MODEL_1_MIN_REPLICAS=1

# Multi-model mode (uncomment and set to use):
# Declarar MODELS_COUNT=N exige MODEL_1_ID..MODEL_N_ID e os SOURCE
# correspondentes — declarar menos do que N agora é erro, não omissão silenciosa.
# MODELS_COUNT=2
# MODEL_1_ID=mistral-7b
# MODEL_1_SOURCE=mistralai/Mistral-7B-Instruct-v0.3
# MODEL_2_ID=qwen-2.5-14b
# MODEL_2_SOURCE=Qwen/Qwen2.5-14B-Instruct-AWQ
# MODEL_2_QUANTIZATION=awq
# MODEL_2_DTYPE=float16

# Maximum context length in tokens (optional, default: 8192)
MAX_MODEL_LEN=8192

# Fraction of GPU memory to reserve for weights + KV cache (optional, default: 0.9)
GPU_MEMORY_UTILIZATION=0.9

# Number of GPUs available on the node (optional, default: 1)
# Used by VRAM budget validation to ensure multi-model configs fit.
GPU_COUNT=1

# VRAM per GPU in GB (optional, default: 24.0 — matches A10G on g5.xlarge)
GPU_VRAM_GB=24.0

# Grafana admin password — required if Grafana is enabled (see §5.4)
GRAFANA_ADMIN_PASSWORD=changeme

# ── Provisionamento de usuários (scripts/colleague.sh) ────────────────────
# Host anunciado ao usuário nas credenciais que o script imprime. Use o
# nome DNS ou IP pelo qual as pessoas realmente alcançam o servidor.
# Nunca coloque isto no código — ver issue #2.
IDIA_PUBLIC_HOST=localhost

# Virtual key dedicada à DESCOBERTA de modelos pelo Open WebUI. Não é a
# chave de nenhum usuário: o Open WebUI a usa apenas para listar o que
# existe no LiteLLM; cada pessoa conversa com a própria key.
# Gere com:  ./idia colleague key discovery@local --tier light
# Sem esta variável, o passo [6/6] do provisionamento é pulado com aviso.
OWUI_DISCOVERY_KEY=

# Nome do container do Open WebUI (default: idia-webui)
OWUI_CONTAINER=idia-webui

# Portas publicadas (defaults: LiteLLM 4000, Open WebUI 3001)
LITELLM_PORT=4000
OWUI_PORT=3001
