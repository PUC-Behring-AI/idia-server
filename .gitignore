# Environment
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.eggs/
*.whl
.pytest_cache/
.coverage
# Per-process data files: pytest-cov measures the subprocesses the suite spawns
# and writes one .coverage.<host>.<pid>.<rand> per child before combining them.
# A crashed run leaves them behind, and a leftover file from a statement-only
# run makes the next branch-mode run fail to combine.
.coverage.*
coverage/
htmlcov/
.tmp/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
*.orig

# OS
.DS_Store
Thumbs.db

# Project-specific
.ka/
.cache/
.huggingface/

# Rendered configs (generated by `./idia deploy local` or --render-all)
# These contain real model names resolved from .env. They are generated
# at deploy time and must NOT be committed (they change per deployment).
rendered_serve_config.yaml
rendered_litellm_config.yaml

# Governança do repositório — o portão local e a exigência de vizinhança
# pertencem ao repo, não à máquina. Worktrees, não.
.claude/worktrees/
