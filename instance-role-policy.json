{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AutoscalerGerenciaWorkers",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:TerminateInstances",
        "ec2:Describe*",
        "ec2:CreateTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassarAPropriaRoleAosWorkers",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/ray-cluster-node-role"
    }
  ]
}
